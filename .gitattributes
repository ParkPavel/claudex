* text=auto
*.mjs text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
.githooks/* text eol=lf
setup.sh text eol=lf
setup.cmd text eol=crlf

# A release archive is an installation, not a source checkout. Keep the
# maintained evidence and development machinery in Git without making every
# installation carry it or inviting agents to read it as runtime context.
/.editorconfig export-ignore
/.gitattributes export-ignore
/.github export-ignore
/.githooks export-ignore
/.gitignore export-ignore
/CONTRIBUTING.md export-ignore
/docs/research export-ignore
/package-lock.json export-ignore
/scripts export-ignore
/test export-ignore
